{
  "_comment": "Windows 執行環境安裝清單（主後端最小依賴）。GPT-SoVITS 由 setup_gptsovits.ps1 獨立安裝。",
  "profiles": {
    "nvidia-cuda": {
      "label": "NVIDIA GPU（CUDA）",
      "min_vram_mb": 6144,
      "min_disk_gb": 30,
      "components": ["uv", "managed-python", "ffmpeg", "backend-deps", "whisper"]
    },
    "cpu-only": {
      "label": "CPU 模式（無 GPU 或 VRAM 不足）",
      "min_ram_gb": 8,
      "min_disk_gb": 15,
      "components": ["uv", "managed-python", "ffmpeg", "backend-deps", "whisper"]
    }
  },
  "components": {
    "uv": {
      "label": "uv（Python 管理器）",
      "size_mb": 5,
      "download_url": "https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-pc-windows-msvc.zip",
      "extract_to": "uv",
      "marker": ".uv-installed"
    },
    "managed-python": {
      "label": "Python 3.10（隔離環境）",
      "size_mb": 60,
      "install_cmd": ["{uv}", "python", "install", "3.10"],
      "marker": ".python-installed"
    },
    "ffmpeg": {
      "label": "FFmpeg（音訊處理）",
      "size_mb": 100,
      "download_url": "https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip",
      "extract_to": "ffmpeg",
      "strip_top_dir": true,
      "marker": ".ffmpeg-installed"
    },
    "backend-deps": {
      "label": "主後端依賴（FastAPI / httpx）",
      "size_mb": 50,
      "cmd": [
        "{uv}", "pip", "install", "--python", "{venv_python}",
        "fastapi", "uvicorn[standard]", "httpx", "python-multipart", "soundfile"
      ],
      "marker": ".backend-deps-installed"
    },
    "whisper": {
      "label": "Faster-Whisper（用於 YouTube 轉錄）",
      "size_mb": 200,
      "cmd": [
        "{uv}", "pip", "install", "--python", "{venv_python}",
        "faster-whisper"
      ],
      "marker": ".whisper-installed"
    }
  }
}
